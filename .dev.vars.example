OPENAI_API_KEY=sk-proj-...
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_SITE_URL=https://your-domain.com
OPENROUTER_SITE_NAME=Your Site Name
OPENROUTER_MODELS=openrouter/free,meta-llama/llama-3.2-90b-instruct:free,anthropic/claude-3.5-sonnet,openai/gpt-4o
OPENROUTER_GUARDRAIL_MODELS=openrouter/free,openai/gpt-4o-mini
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-api-key>
LANGSMITH_PROJECT=<your-project-name>

# Logging Configuration
# LOGGER_LEVEL: DEBUG|INFO|WARN|ERROR (default: DEBUG for development)
# LOGGER_FORMAT: json|pretty (default: pretty for development)
LOGGER_LEVEL=DEBUG
LOGGER_FORMAT=pretty