{
  "name": "cloudflare-agent-starter",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "vite dev",
    "build": "vite build",
    "set_secrets": "wrangler secret bulk .dev.vars",
    "deploy": "npm run test:ci && vite build && wrangler deploy",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:openrouter": "tsx tests/run-all-tests.ts",
    "types": "wrangler types env.d.ts --include-runtime false",
    "format": "prettier --write .",
    "check": "prettier . --check && biome lint && tsc"
  },
  "keywords": [
    "cloudflare",
    "ai",
    "agents"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
