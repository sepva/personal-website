    "@cloudflare/ai-chat": "^0.0.5",
    "@openrouter/ai-sdk-provider": "^2.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
